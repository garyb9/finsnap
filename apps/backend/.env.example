APP_PORT=4000
LOG_LEVEL=info

# Postgres.
# This value is for running on the host (`yarn dev`). docker-compose overrides
# it with postgres://postgres:postgres@postgres:5432/finsnap, so leaving it as
# localhost is correct either way.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/finsnap

# ── Telegram (optional) ──────────────────────────────────────────────────────
# Leave blank to run without it. Delivery is disabled with a warning; the API,
# dashboard, schedulers and backtests are unaffected.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Ops channel pinged when the scheduled snap/report cron fails outright —
# those jobs have no caller to surface the error to otherwise. Optional;
# blank means failures are only logged. Reuses TELEGRAM_BOT_TOKEN above.
TELEGRAM_OPS_CHANNEL_ID=

# polling | webhook | off
#   polling  needs a process that stays up — right for docker/Fly/Railway
#   webhook  Telegram pushes to POST /telegram/webhook — required on serverless
TELEGRAM_MODE=polling

# Webhook mode only. Public base URL of this API, no trailing path.
TELEGRAM_WEBHOOK_URL=
# Shared secret Telegram echoes back so the endpoint can reject forgeries.
TELEGRAM_WEBHOOK_SECRET=

# ── API auth (optional) ──────────────────────────────────────────────────────
# Guards POST /sync, /report/trigger and /snap/trigger with a bearer token.
# Unset leaves them open, which is fine locally. SET THIS before exposing the
# API publicly — POST /sync starts a multi-minute fetch of the whole universe.
API_TOKEN=

# Universe — Yahoo Finance symbols, comma-separated.
# Anything you add here is backtested and reported; symbols listed in
# src/constants/assets.ts also get a plain-English entry in the field guide.
CRYPTO_SYMBOLS=BTC-USD

#   indices     SPY QQQ DIA IWM EEM EFA
#   sectors     XLK XLF XLE XLV XLI XLY XLP XLU XLB XLRE VNQ XLC
#   industry    SMH XPH
#   macro       GLD SLV USO UNG UUP FXE FXY LQD HYG TLT VXX IBIT
EQUITY_SYMBOLS=SPY,QQQ,DIA,IWM,EEM,EFA,XLK,XLF,XLE,XLV,XLI,XLY,XLP,XLU,XLB,XLRE,VNQ,XLC,SMH,XPH,GLD,SLV,USO,UNG,UUP,FXE,FXY,LQD,HYG,TLT,VXX,IBIT

# Options chains are only pulled for these (paging every expiry is slow).
# Effectively the whole universe except the currency/nat-gas funds, whose
# options are listed but too thin to be worth the fetch.
OPTIONS_SYMBOLS=SPY,QQQ,DIA,IWM,EEM,EFA,XLK,XLF,XLE,XLV,XLI,XLY,XLP,XLU,XLB,XLRE,VNQ,XLC,SMH,XPH,GLD,SLV,USO,TLT,LQD,HYG,VXX,IBIT

# Backtest execution assumptions
BACKTEST_CAPITAL=10000
BACKTEST_FEE_BPS=5
BACKTEST_SLIPPAGE_BPS=5

# Schedulers
# Live snapshot — hourly. Bars sync incrementally now, so each run just picks
# up current price plus whatever's missing, rather than re-fetching history.
SNAP_CRON=0 * * * *
# Daily backtest report — 08:00 on weekdays, 90 minutes before the US open
REPORT_CRON=0 8 * * 1-5
REPORT_TIMEZONE=America/New_York
